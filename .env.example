RAG_PLATFORM_BASE_URL=http://localhost:8000
# Only used as a local-dev fallback when running the MCP server standalone, outside the API/UI's
# per-caller session flow (AGT-006: the API/UI themselves have no service-account fallback --
# every real request must bring its own RAG_PLATFORM_ACCESS_TOKEN/CSRF_TOKEN below).
RAG_PLATFORM_EMAIL=agentic-ai-service@example.com
RAG_PLATFORM_PASSWORD=changeme
# Set only by the MCP server subprocess itself, per-call (AGT-013) -- never set these manually.
# When both are present, they override RAG_PLATFORM_EMAIL/PASSWORD for that one call, so retrieval
# runs as the logged-in end user (via the API's Authorization + X-RAG-CSRF-Token headers, or the
# UI's login) instead of the fallback account above.
RAG_PLATFORM_ACCESS_TOKEN=
RAG_PLATFORM_CSRF_TOKEN=
# "ollama" (default, local dev, free) or "openrouter" (AGT-004 -- used for deployment, since the
# deploy target has no room to run Ollama; see docs/architecture.md's "Deployment" section).
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen3
# Only needed when LLM_PROVIDER=openrouter. Defaults below are both free-tier models from a
# family OpenRouter positions for agentic/tool-calling use (live-verified 2026-10-01: 3/3 success
# on the exact structured-output task that was flaky with local models -- see AGT-010).
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-nano-30b-a3b:free
OPENROUTER_FALLBACK_MODEL=nvidia/nemotron-3.5-lightning:free
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
MAX_VERIFICATION_RETRIES=2
# AGT-017: comma-separated origins the standalone frontend (frontend/) may call this API from.
# Defaults to Vite's local dev server only; set to the deployed Vercel origin in production.
CORS_ALLOWED_ORIGINS=http://localhost:5173
