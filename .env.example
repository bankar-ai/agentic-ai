RAG_PLATFORM_BASE_URL=http://localhost:8000
RAG_PLATFORM_EMAIL=agentic-ai-service@example.com
RAG_PLATFORM_PASSWORD=changeme
# Set only by the MCP server subprocess itself, per-call (AGT-013) -- never set this manually.
# When present, it overrides RAG_PLATFORM_EMAIL/PASSWORD for that one call, so retrieval runs as
# the logged-in end user (via the API's Authorization header or the UI's login) instead of the
# fixed service account above.
RAG_PLATFORM_ACCESS_TOKEN=
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen3
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
MAX_VERIFICATION_RETRIES=2
